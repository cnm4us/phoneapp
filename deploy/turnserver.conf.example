# Render to /etc/phoneapp/turnserver.conf with a generated secret; never commit the rendered file.
listening-port=3478
tls-listening-port=5349
listening-ip=172.31.10.226
relay-ip=172.31.10.226
external-ip=54.183.144.33/172.31.10.226
realm=phoneapp.bawebtech.com
server-name=phoneapp.bawebtech.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_BACKEND_TURN_SECRET
min-port=49160
max-port=49200
user-quota=12
total-quota=48
max-bps=1000000
bps-capacity=12000000
max-allocate-lifetime=1800
stale-nonce=600
no-multicast-peers
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-cli
no-tcp-relay
no-dtls
no-tlsv1
no-tlsv1_1
cert=/etc/phoneapp/tls/fullchain.pem
pkey=/etc/phoneapp/tls/privkey.pem
log-file=stdout
simple-log
