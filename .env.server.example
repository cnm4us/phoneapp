# Copy to .env.server. Generate a private key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Enter that key only on the phone creating a test room; never embed it in EXPO_PUBLIC_ variables.
POC_ACCESS_KEY=
HOST=127.0.0.1
PORT=8787
STUN_URLS=stun:stun.l.google.com:19302
# Configure both values for coturn shared-secret authentication. Optional for same-network experiments;
# required before cross-network/forced-relay acceptance. The shared secret stays on the servers.
TURN_URLS=
TURN_SECRET=
