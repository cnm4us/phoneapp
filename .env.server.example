# Copy to .env.server. Generate a private key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Enter that key only on the phone creating a test room; never embed it in EXPO_PUBLIC_ variables.
POC_ACCESS_KEY=
HOST=127.0.0.1
PORT=8787
# Test room lifetime from creation, in minutes; maximum 480.
ROOM_TTL_MINUTES=240
STUN_URLS=stun:stun.l.google.com:19302
# Configure both values for coturn shared-secret authentication. Optional for same-network experiments;
# required before cross-network/forced-relay acceptance. The shared secret stays on the servers.
TURN_URLS=
TURN_SECRET=
# Video payload ceiling below the existing 8 Mbps TURN allocation limit; bits/s.
RELAY_VIDEO_MAX_BITRATE=6000000
# Enable only after device/route capacity verification. Default false.
ENABLE_EXPERIMENTAL_ULTRA=false

# Optional synthetic provider/patient workflow; apply migrations/grants first.
ENABLE_ACCOUNT_CALLS=false

# Unified communication history (schema-compatible Stage A; source calling/media flags still apply).
ENABLE_COMMUNICATION_WORKSPACE=false
