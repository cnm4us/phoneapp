[Unit]
Description=Phoneapp POC signaling
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/phoneapp
ExecStart=/home/ubuntu/.nvm/versions/node/v22.21.1/bin/node --env-file=/home/ubuntu/phoneapp/.env.server /home/ubuntu/phoneapp/node_modules/tsx/dist/cli.mjs server/index.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
