{
  "name": "phoneapp",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "dev:server": "tsx watch --env-file=.env.server server/index.ts",
    "start:server": "tsx --env-file=.env.server server/index.ts",
    "test": "npm run build:web && tsx --test server/server.test.ts src/call/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/tests/tsconfig.json && tsc --noEmit -p database/tsconfig.json",
    "check:docs": "python3 scripts/check_project.py",
    "doctor": "expo-doctor",
    "build:ios": "eas build --platform ios --profile development",
    "build:android": "eas build --platform android --profile development",
    "init:local": "node scripts/init-local.mjs",
    "smoke": "tsx --env-file=.env.server scripts/smoke.ts",
    "bundle:check": "expo export --platform ios --platform android --output-dir artifacts/bundles",
    "build:web": "node scripts/build-web.mjs",
    "test:browser": "npm run build:web && playwright test",
    "test:browser:live": "node --env-file=.env.server scripts/test-browser-live.mjs",
    "test:quality-network": "npm run build:web && tsx scripts/check-quality-network.ts",
    "db:provision": "python3 scripts/provision-database.py",
    "db:grants": "python3 scripts/provision-database.py --grants",
    "db:check": "tsx database/cli.ts check",
    "db:status": "tsx database/cli.ts status",
    "db:migrate": "tsx database/cli.ts migrate",
    "db:seed": "tsx database/cli.ts seed",
    "test:db": "tsx --test database/database.test.ts",
    "test:db:permissions": "tsx --test database/permissions.test.ts",
    "accounts:enroll": "tsx scripts/enrollment.ts",
    "test:native-calls": "tsx --test server/native-calls.test.ts",
    "test:accounts": "npm run build:web && tsx --test server/accounts.test.ts",
    "smoke:accounts": "tsx scripts/smoke-accounts.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "expo": "57.0.33",
    "expo-build-properties": "57.0.23",
    "expo-dev-client": "57.0.21",
    "expo-status-bar": "57.0.1",
    "mariadb": "3.5.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webrtc": "155.0.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "expo-doctor": "1.21.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
